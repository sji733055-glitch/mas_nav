{
    // 搜索设置
    "search.exclude": {
        "**/build": true,
        "**/install": true,
        "**/log": true
    },
    // 终端配置
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "/bin/bash",
            "args": []
        }
    },

    // CMake 配置
    "cmake.configureOnOpen": true,

    // Python 配置
    "python.defaultInterpreterPath": "/usr/bin/python3",

    // 编辑器通用配置
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "ROS2.distro": "jazzy",
    "python.autoComplete.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages",
        "/opt/ros/jazzy/local/lib/python3.12/dist-packages"
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages",
        "/opt/ros/jazzy/local/lib/python3.12/dist-packages"
    ],
    "cmake.ignoreCMakeListsMissing": true,

    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    
    // Clangd 配置
    "clangd.path": "clangd",
    "clangd.arguments": [
        // 编译库不再用 --compile-commands-dir 指定：由仓库里的 src/.clangd 指向 ../build，
        // 与编辑器无关（旧值 ${workspaceFolder}/build 在把 src/ 当工作区打开时并不存在）。
        // 后台索引
        "--background-index",
        // 禁用自动插入头文件
        "--header-insertion=never",
        // 补全时显示更多信息
        "--completion-style=detailed",
        "--pch-storage=disk",
        // 日志级别
        "--log=info",
        // 启用clang-tidy静态分析
        "--clang-tidy",
        // 跨文件重命名
        "--cross-file-rename",
        // 并行索引任务数
        "-j=4",
        // 限制补全结果数量
        "--limit-results=50"
    ],
    // Clangd fallback 配置 - 编译库里没有条目的文件（如 3rdparty 的 demo/benchmark）用这套兜底。
    // 必须与机器上的实际发行版一致：本机是 ROS 2 Jazzy + PCL 1.14（旧值 humble / pcl-1.12 对不上）。
    "clangd.fallbackFlags": [
        "-std=c++17",
        // ROS2 核心头文件
        "-I/opt/ros/jazzy/include",
        // 第三方库
        "-I/usr/include/eigen3",
        "-I/usr/include/pcl-1.14",
        "-I/usr/include/opencv4",
        "-I/usr/include/vtk-9.1"
    ],
    "clangd.onConfigChanged": "prompt",
    // 排除不需要索引的目录
    "files.watcherExclude": {
        "**/build/**": true,
        "**/install/**": true,
        "**/log/**": true
    }
}
