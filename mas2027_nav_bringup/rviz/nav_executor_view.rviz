Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Axes: true
      Show Arrows: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: robot_description
      Enabled: true
      Name: Robot
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 100
      Name: Odometry
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Color: 255; 255; 0
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /Odometry
      Value: true
    - Alpha: 0.45
      Autocompute Intensity Bounds: true
      Axis: Z
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 180; 180; 180
      Decay Time: 0
      Enabled: true
      Name: Prior Map
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom_localizer/prior_cloud
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.45
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Name: HW Cost Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cost_map
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cost_map_updates
      Use Timestamp: false
      Value: true
    - Alpha: 0.65
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: false
      Name: Planning Constraints (raster diagnostic)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planning_constraints
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planning_constraints_updates
      Use Timestamp: false
      Value: false
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Planning Constraints (red=blocked, yellow=directional)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planning_constraints_markers
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Dynamic Obstacles (cyan, current)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nav_executor/debug/dynamic_obstacles
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: HW Direction Map
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /direction_map
      Value: false
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.55
          Class: rviz_default_plugins/Map
          Color Scheme: map
          Draw Behind: true
          Enabled: false
          Name: Dynamic Layer Value
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/layer_value_dynamic
          Use Timestamp: false
          Value: false
        - Alpha: 0.55
          Class: rviz_default_plugins/Map
          Color Scheme: map
          Draw Behind: true
          Enabled: false
          Name: Static Layer Value (prior disabled)
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/layer_value_static
          Use Timestamp: false
          Value: false
        - Alpha: 0.45
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Draw Behind: true
          Enabled: true
          Name: Layer Type
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/layer_type
          Use Timestamp: false
          Value: true
        - Alpha: 0.55
          Class: rviz_default_plugins/Map
          Color Scheme: map
          Draw Behind: true
          Enabled: false
          Name: Layer Value
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/layer_value
          Use Timestamp: false
          Value: false
        - Alpha: 0.32
          Autocompute Intensity Bounds: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Max Color: 125; 220; 255
          Min Color: 30; 30; 90
          Name: 2D Distance Field
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.04
          Style: Flat Squares
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/field
          Use Fixed Frame: true
          Value: true
        - Alpha: 0.6
          Autocompute Intensity Bounds: true
          Axis: Z
          Channel Name: z
          Class: rviz_default_plugins/PointCloud2
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Name: Height Analysis
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.05
          Style: Points
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/layer_height_delta
          Use Fixed Frame: true
          Value: true
        - Alpha: 0.85
          Class: rviz_default_plugins/PointCloud2
          Color: 170; 0; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Occupied (purple cubes)
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.05
          Style: Boxes
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/occupied
          Use Fixed Frame: true
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Map Bound
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/map_bound
          Value: true
      Enabled: true
      Name: ROGMAP
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Axis: Z
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Name: Registered Cloud
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cloud_registered_full
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Axes Length: 0.3
      Axes Radius: 0.03
      Class: rviz_default_plugins/Pose
      Color: 255; 25; 0
      Enabled: true
      Head Length: 0.15
      Head Radius: 0.05
      Name: Goal
      Shaft Length: 0.35
      Shaft Radius: 0.03
      Shape: Arrow
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
      Value: true
    - Alpha: 0.6
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 200; 0
      Enabled: true
      Line Style: Billboards
      Line Width: 0.04
      Name: MINCO Trajectory (Path)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nav_executor/global_path
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: MINCO Trajectory
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nav_executor/debug/minco_trajectory
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Safe Corridor (backup SFC)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nav_executor/debug/safe_corridor
      Value: true
    # 全局搜索（SMAC 2D / Astar）输出的折线。放在显示列表最后 = 最后渲染 = 画在最上层。
    # 线宽/颜色由消息里的 Marker 决定（node.visualization.global_plan_*），默认 0.15 m 青色，
    # 比 MINCO 轨迹（0.07 m、按速度染色）粗一倍以上，用来一眼看清「搜索想让它怎么绕」。
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Global Plan (SMAC search, thick)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nav_executor/debug/global_plan
      Value: true
    # 同一条折线的 nav_msgs/Path 版本，给需要量坐标/取点数的工具用（虚线细一点，不抢视线）。
    - Alpha: 0.9
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 255
      Enabled: true
      Line Style: Billboards
      Line Width: 0.12
      Name: Global Plan (Path)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nav_executor/global_plan
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.9
      Yaw: 0.785
Window Geometry:
  Height: 900
  Width: 1400
