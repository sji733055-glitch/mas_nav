<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>map_server</name>
  <version>0.0.1</version>
  <description>
    先验地形图服务：加载 msgpack 地形图（语义标签 + 方向场），发布膨胀后的
    静态全局代价图与区域标签图。在线障碍由 nav_executor 内的 ROGMap 独占负责。
  </description>
  <maintainer email="mitsuha.2213@gmail.com">@Polyacetone</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>python3-pil</exec_depend>
  <!-- msgpack-cxx 由 CMake find_package 定位（libmsgpack-cxx-dev），与上游一致不在此声明 -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
