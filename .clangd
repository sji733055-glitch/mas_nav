# clangd 配置。生成编译库的脚本：src/tools/gen_compile_commands.sh（详见 README「环境与编译」）。
#
# 本工作区是 colcon 多包布局，编译库只能放 build/（不进仓库，见 .gitignore）。clangd 默认沿源文件
# 的父目录向上找 compile_commands.json，找不到时就拿"名字最像"的别的文件去猜编译命令，于是出现
# 满屏 'xxx.hpp file not found' / 'use of undeclared identifier'，跨文件跳转同时失效。
# 这里显式指向 build/，不依赖编辑器参数，换编辑器也一样生效。
CompileFlags:
  CompilationDatabase: ../build

# 后台建索引（跳转/全局符号依赖它）。
Index:
  Background: Build
